# ==========================================
# DevFoundry — All Environment Variables
# ==========================================
# Copy this file to .env at the repo root and fill in your values.
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env (Windows PowerShell)

# ------------------------------------------
# Frontend — Microsoft Entra (Azure AD)
# ------------------------------------------
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173/auth-callback
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Backend — Supabase
# Use the SERVICE-ROLE key (Project Settings -> API). After migration 003 the tables are closed
# to the anon key. Never expose this key to the frontend.
# ------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
# Optional: takes precedence over SUPABASE_KEY when set
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------
# Backend — API sign-in (Microsoft Entra ID token validation)
# Optional: default to VITE_AZURE_TENANT_ID / VITE_AZURE_CLIENT_ID above
# ------------------------------------------
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# ------------------------------------------
# Backend — Azure OpenAI
# Primary LLM provider; falls back to Groq if omitted or unavailable
# ------------------------------------------
AZURE_OPENAI_APIKEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ------------------------------------------
# Backend — Groq
# Secondary LLM fallback (e.g. openai/gpt-oss-120b or openai/gpt-oss-20b)
# ------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Comma-separated, tried in order (each Groq model has its own free-tier quota)
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b

# ------------------------------------------
# Backend — MAQ AI (SLM)
# Tertiary fallback (https://llm.maqsoftware.net/v1, e.g. qwen-3.8-27b)
# ------------------------------------------
MAQ_AI_API_KEY=
MAQ_AI_BASE_URL=https://llm.maqsoftware.net/v1
MAQ_AI_MODEL=qwen-3.8-27b

# LLM timeouts / retries per provider (optional; defaults shown). MAQ AI is streamed, so its gateway's 120 s
# Cloudflare limit does not apply; set MAQ_AI_STREAM=false to disable streaming.
AZURE_OPENAI_TIMEOUT_SECONDS=
AZURE_OPENAI_MAX_RETRIES=
GROQ_TIMEOUT_SECONDS=
GROQ_MAX_RETRIES=
GROQ_MAX_REQUEST_TOKENS=
MAQ_AI_TIMEOUT_SECONDS=
MAQ_AI_MAX_RETRIES=
MAQ_AI_STREAM=

# ------------------------------------------
# Backend — Azure DevOps (MCP Project & Repo Setup)
# Required for Repo_Setup_Agent to create ADO projects & Git repos
# ------------------------------------------
AZURE_DEVOPS_ORG_NAME=
AZURE_DEVOPS_PAT=
# Optional: repository scaffold push defaults
ADO_SCAFFOLD_COMMIT_MESSAGE=
ADO_SCAFFOLD_DEFAULT_BRANCH=
# Repository generator commands (optional)
SCAFFOLD_COMMAND_TIMEOUT_SECONDS=
SCAFFOLD_ALLOWED_PACKAGES=

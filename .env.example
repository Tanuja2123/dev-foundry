# ==========================================
# DevFoundry — All Environment Variables
# ==========================================
# Copy this file to .env at the repo root and fill in your values.
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env (Windows PowerShell)

# ------------------------------------------
# Frontend — Microsoft Entra (Azure AD)
# ------------------------------------------
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173/auth-callback
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Backend — Supabase
# Optional: falls back to in-memory store if omitted
# ------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------
# Backend — Azure OpenAI
# Optional: falls back to demo AI responses if omitted
# ------------------------------------------
AZURE_OPENAI_APIKEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ------------------------------------------
# Backend — Azure DevOps (MCP Project & Repo Setup)
# Required for Repo_Setup_Agent to create ADO projects & Git repos
# ------------------------------------------
AZURE_DEVOPS_ORG_NAME=
AZURE_DEVOPS_PAT=
# Optional: repository scaffold push defaults
ADO_SCAFFOLD_COMMIT_MESSAGE=
ADO_SCAFFOLD_DEFAULT_BRANCH=
